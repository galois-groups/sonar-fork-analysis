{
  "name": "sonar-fork-analysis",
  "description": "Sonar scan external forks of your project",
  "version": "0.0.0",
  "author": "Claudio Nave",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/galois-groups/sonar-fork-analysis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galois-groups/sonar-fork-analysis.git"
  },
  "bugs": {
    "url": "https://github.com/galois-groups/sonar-fork-analysis/issues"
  },
  "keywords": [
    "actions",
    "sonar"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint --max-warnings 0 .",
    "lint:deps": "npx knip && npx lockfile-lint",
    "lint:workflows": "node scripts/lint-workflows.ts",
    "local": "npm run package && node --env-file=.env dist/index.js",
    "package": "vite build",
    "package:watch": "vite build --watch",
    "scanner:check": "node scripts/scanner-version.ts",
    "scanner:update": "node scripts/scanner-version.ts --update",
    "test": "vitest run",
    "test:scanner": "SCANNER_CHECKS=1 vitest run __tests__/real-scanner.test.ts --coverage.enabled=false",
    "typecheck": "npx tsc --project . && npx tsc --project __tests__ && npx tsc --project scripts",
    "all": "npm run format:write && npm run lint && npm run lint:deps && npm run lint:workflows && npm run typecheck && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/tool-cache": "^4.0.0",
    "openpgp": "^6.3.2"
  },
  "devDependencies": {
    "@actions/workflow-parser": "^0.3.61",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@octokit/openapi-webhooks-types": "^12.2.0",
    "@openpgp/web-stream-tools": "^0.3.1",
    "@sonar/scan": "^5.0.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-regexp": "^3.3.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "lockfile-lint": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSameLine": true,
    "proseWrap": "always"
  },
  "knip": {
    "entry": [
      "__fixtures__/*.ts"
    ],
    "project": [
      "src/**/*.ts",
      "scripts/**/*.ts",
      "__tests__/**/*.ts",
      "__fixtures__/**/*.ts"
    ],
    "ignoreBinaries": [
      "java",
      "javap"
    ],
    "ignore": [
      "dist/**"
    ],
    "ignoreDependencies": [
      "@sonar/scan"
    ]
  },
  "lockfile-lint": {
    "path": "package-lock.json",
    "type": "npm",
    "allowedHosts": [
      "npm"
    ],
    "validateHttps": true,
    "validateIntegrityStrict": true,
    "validatePackageNames": true,
    "allowedPackageNameAliases": [
      "string-width-cjs:string-width",
      "strip-ansi-cjs:strip-ansi",
      "wrap-ansi-cjs:wrap-ansi"
    ]
  }
}
